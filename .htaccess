

# BEGIN Smart Choice Security, SEO, Cache and HTTPS Hardening
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonicalize every request to HTTPS and the non-WWW hostname.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.justsmartchoice\.com$ [NC]
  RewriteRule ^ https://justsmartchoice.com%{REQUEST_URI} [L,R=301,NE]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Cross-Origin-Resource-Policy "same-site"
  Header always set Content-Security-Policy "default-src 'self' https: data: blob:; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com https://analytics.ahrefs.com https://widget.trustpilot.com https://crm.justsmartchoice.com https://www.google.com https://www.gstatic.com https://js.pusher.com; script-src-elem 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://analytics.ahrefs.com https://widget.trustpilot.com https://crm.justsmartchoice.com https://www.google.com https://www.gstatic.com https://js.pusher.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://analytics.ahrefs.com https://widget.trustpilot.com https://*.trustpilot.com https://crm.justsmartchoice.com https://sockjs.pusher.com https://*.pusher.com wss://*.pusher.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://www.google.com https://widget.trustpilot.com https://crm.justsmartchoice.com; form-action 'self' https://crm.justsmartchoice.com; frame-ancestors 'self'; upgrade-insecure-requests"
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|php|xml|txt)$">
    Header set Cache-Control "public, max-age=900"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
# END Smart Choice Security, SEO, Cache and HTTPS Hardening



# BEGIN cPanel-generated php ini directives, do not edit
